flowchart TD
    %% PawPal+ system architecture and data flow (input -> process -> output).
    %% Shows the two subsystems (deterministic scheduler + RAG advisor), the
    %% retriever/generator/fallback components, and where humans and tests check
    %% the AI's output. The class-level design lives in diagrams/uml_final.mmd.

    User([Pet owner]):::human
    UI["Streamlit UI (app.py)<br/>owner, pets, tasks, time budget"]:::io

    User -->|enters owner / pets / tasks / minutes| UI

    subgraph Scheduler["Deterministic Scheduler (pawpal_system.py)"]
        direction TB
        Plan["build_plan / sort_by_time / filter_tasks"]:::proc
        Conflicts["detect_conflicts + recurrence"]:::proc
    end

    subgraph RAG["RAG Advisor (pawpal_ai.py)"]
        direction TB
        Query["Build query from pet + tasks"]:::proc
        Retriever["Retriever<br/>keyword scoring"]:::proc
        KB[("Knowledge base<br/>knowledge/*.md")]:::data
        PromptB["Prompt builder<br/>retrieved notes + schedule"]:::proc
        Gen{"Generator<br/>fallback chain"}:::decision
        Anthropic["Anthropic API<br/>(if API key)"]:::model
        Ollama["Local Ollama<br/>llama3.2"]:::model
        Offline["Offline template<br/>(guardrail)"]:::model

        Query --> Retriever
        Retriever -->|searches| KB
        KB -->|top-k guideline chunks| PromptB
        Query --> PromptB
        PromptB --> Gen
        Gen -->|1st| Anthropic
        Gen -->|2nd| Ollama
        Gen -->|fallback| Offline
    end

    UI -->|"Auto-fit plan"| Plan
    UI -->|"Advise on pet"| Query

    Plan --> PlanOut["Today's schedule + reasoning"]:::io
    Conflicts --> PlanOut
    Anthropic --> Advice["Grounded advice + sources + backend"]:::io
    Ollama --> Advice
    Offline --> Advice

    PlanOut --> UI
    Advice --> UI
    UI -->|reviews plan & advice, decides what to do| User

    Log[["pawpal.log<br/>retrieval + backend audit trail"]]:::log
    RAG -.logs.-> Log

    subgraph Testing["Automated tests (pytest)"]
        direction TB
        T1["Scheduler tests<br/>tests/test_pawpal.py"]:::test
        T2["RAG reliability tests<br/>tests/test_pawpal_ai.py<br/>retrieval + fallback"]:::test
    end

    T1 -.verifies.-> Scheduler
    T2 -.verifies.-> RAG

    classDef human fill:#fde2c4,stroke:#b5651d,color:#000
    classDef io fill:#dbeafe,stroke:#2563eb,color:#000
    classDef proc fill:#e5e7eb,stroke:#4b5563,color:#000
    classDef data fill:#dcfce7,stroke:#16a34a,color:#000
    classDef model fill:#ede9fe,stroke:#7c3aed,color:#000
    classDef decision fill:#fef9c3,stroke:#ca8a04,color:#000
    classDef test fill:#fee2e2,stroke:#dc2626,color:#000
    classDef log fill:#f3f4f6,stroke:#6b7280,color:#000
